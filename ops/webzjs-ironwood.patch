+
+    #[cfg(feature = "transparent-inputs")]
+    fn get_transparent_receivers(
+        &self,
+        account_id: Self::AccountId,
+        _include_change: bool,
+        _include_standalone: bool,
+    ) -> Result<HashMap<TransparentAddress, TransparentAddressMetadata>, Self::Error> {
+        let account = self
+            .get_account(account_id)?
+            .ok_or(Error::AccountUnknown(account_id))?;
+
+        // The in-memory wallet derives no internal-scope (change) or standalone transparent
+        // addresses (shielded change only), so the exposed external receivers are the full set.
+        let t_addresses = account
+            .addresses()
+            .iter()
+            .filter_map(|(diversifier_index, ua)| {
+                ua.transparent().map(|ta| {
+                    let metadata = TransparentAddressMetadata::derived(
+                        Scope::External.into(),
+                        NonHardenedChildIndex::from_index((*diversifier_index).try_into().unwrap())
+                            .expect(
+                                "diversifier index corresponds to a valid NonHardenedChildIndex",
+                            ),
+                        Exposure::Unknown,
+                        None,
+                    );
+
+                    (*ta, metadata)
+                })
+            })
+            .collect();
+        Ok(t_addresses)
+    }
+
+    #[cfg(feature = "transparent-inputs")]
+    fn get_transparent_address_metadata(
+        &self,
+        account: Self::AccountId,
+        address: &TransparentAddress,
+    ) -> Result<Option<TransparentAddressMetadata>, Self::Error> {
+        // No ephemeral or change addresses exist in this wallet, so the exposed external
+        // receivers (get_transparent_receivers) are the whole set.
+        Ok(self
+            .get_transparent_receivers(account, true, true)?
+            .get(address)
+            .cloned())
+    }
+
+    /// Returns a mapping from each transparent receiver associated with the specified account
+    /// to its not-yet-shielded UTXO balance, including only the effects of transactions mined
+    /// at a block height less than or equal to `summary_height`.
+    ///
+    /// Only non-ephemeral transparent receivers with a non-zero balance at the summary height
+    /// will be included.
+    #[cfg(feature = "transparent-inputs")]
+    fn get_transparent_balances(
+        &self,
+        account_id: Self::AccountId,
+        target_height: TargetHeight,
+        confirmations_policy: ConfirmationsPolicy,
+    ) -> Result<TransparentBalances, Self::Error> {
+        tracing::debug!("get_transparent_balances");
+
+        let mut balances = HashMap::new();
+
+        for (outpoint, txo) in self.transparent_received_outputs.iter().filter(|(_, txo)| {
+            if let Ok(Some(txo_account_id)) =
+                self.find_account_for_transparent_address(&txo.address)
+            {
+                txo_account_id == account_id
+            } else {
+                false
+            }
+        }) {
+            if self.utxo_is_spendable(outpoint, target_height, confirmations_policy)? {
+                let address = txo.address;
+                let key_origin = TransparentKeyOrigin::Derived {
+                    scope: txo.key_scope,
+                };
+                let entry = balances
+                    .entry(address)
+                    .or_insert((key_origin, Balance::ZERO));
+
+                entry.1.add_spendable_value(txo.txout.value())?;
+            }
+        }
+
+        Ok(balances)
+    }
+
+    fn transaction_data_requests(&self) -> Result<Vec<TransactionDataRequest>, Self::Error> {
+        tracing::debug!("transaction_data_requests");
+        Ok(self
+            .transaction_data_request_queue
+            .iter()
+            .cloned()
+            .collect())
+    }
+
+    fn list_addresses(&self, account: Self::AccountId) -> Result<Vec<AddressInfo>, Self::Error> {
+        use zcash_client_backend::data_api::AddressSource;
+        use zcash_keys::address::Address;
+        let acct = self
+            .accounts
+            .get(account)
+            .ok_or(Error::AccountUnknown(account))?;
+        let mut out = vec![];
+        for (di, ua) in acct.addresses().iter() {
+            let source = AddressSource::Derived {
+                diversifier_index: *di,
+                #[cfg(feature = "transparent-inputs")]
+                transparent_key_scope: None,
+            };
+            out.extend(AddressInfo::from_parts(Address::Unified(Box::new(ua.clone())), source));
+            // the transparent receiver tracked at the diversifier index of an exposed UA
+            #[cfg(feature = "transparent-inputs")]
+            if let Some(ta) = ua.transparent() {
+                out.extend(AddressInfo::from_parts(
+                    Address::Transparent(*ta),
+                    AddressSource::Derived {
+                        diversifier_index: *di,
+                        transparent_key_scope: Some(Scope::External.into()),
+                    },
+                ));
+            }
+        }
+        Ok(out)
+    }
+
+    fn find_account_for_address<Q: consensus::Parameters>(
+        &self,
+        params: &Q,
+        address: &zcash_keys::address::Address,
+    ) -> Result<Option<Self::AccountId>, FindAccountForAddressError<Self::Error>> {
+        defaults::find_account_for_address(self, params, address)
+    }
+
+    fn get_last_generated_address_matching(
+        &self,
+        account: Self::AccountId,
+        address_filter: UnifiedAddressRequest,
+    ) -> Result<Option<UnifiedAddress>, Self::Error> {
+        let acct = self
+            .accounts
+            .get(account)
+            .ok_or(Error::AccountUnknown(account))?;
+        let uivk = acct.uivk();
+        // most recently generated (largest diversifier index) address that conforms to the request
+        Ok(acct
+            .addresses()
+            .iter()
+            .rev()
+            .find(|(di, ua)| uivk.address(**di, address_filter).is_ok_and(|a| a == **ua))
+            .map(|(_, ua)| ua.clone()))
+    }
+
+    #[cfg(feature = "transparent-inputs")]
+    fn utxo_query_height(&self, account: Self::AccountId) -> Result<BlockHeight, Self::Error> {
+        // As in the ChainSafe fork: query the node from the account birthday.
+        self.accounts
+            .get(account)
+            .map(|acc| acc.birthday().height())
+            .ok_or(Error::AccountUnknown(account))
+    }
+
+    fn get_received_outputs(
+        &self,
+        txid: TxId,
+        target_height: TargetHeight,
+        confirmations_policy: ConfirmationsPolicy,
+    ) -> Result<Vec<ReceivedTransactionOutput>, Self::Error> {
+        let mut out = vec![];
+        for note in self.received_notes.iter().filter(|n| n.txid == txid) {
+            // 0 if spendable now; 1 as a conservative "not yet" (exact depth is not tracked)
+            let pending = self.note_is_pending(note, target_height, confirmations_policy)?;
+            out.push(ReceivedTransactionOutput::from_parts(
+                note.pool(),
+                note.output_index as usize,
+                note.note.value(),
+                u32::from(pending),
+            ));
+        }
+        #[cfg(feature = "transparent-inputs")]
+        for (outpoint, txo) in self.transparent_received_outputs.iter() {
+            if *outpoint.txid() == txid {
+                let spendable = self
+                    .utxo_is_spendable(outpoint, target_height, confirmations_policy)
+                    .unwrap_or(false);
+                out.push(ReceivedTransactionOutput::from_parts(
+                    PoolType::Transparent,
+                    outpoint.n() as usize,
+                    txo.txout.value(),
+                    u32::from(!spendable),
+                ));
+            }
+        }
+        Ok(out)
+    }
+}
+
+/// Copied from zcash_client_sqlite::wallet::seed_matches_derived_account
+fn seed_matches_derived_account<P: consensus::Parameters>(
+    params: &P,
+    seed: &SecretVec<u8>,
+    seed_fingerprint: &SeedFingerprint,
+    account_index: zip32::AccountId,
+    uivk: &UnifiedIncomingViewingKey,
+) -> Result<bool, Error> {
+    let seed_fingerprint_match =
+        &SeedFingerprint::from_seed(seed.expose_secret()).ok_or_else(|| {
+            Error::BadAccountData("Seed must be between 32 and 252 bytes in length.".to_owned())
+        })? == seed_fingerprint;
+
+    // Keys are not comparable with `Eq`, but addresses are, so we derive what should
+    // be equivalent addresses for each key and use those to check for key equality.
+    let uivk_match =
+        match UnifiedSpendingKey::from_seed(params, &seed.expose_secret()[..], account_index) {
+            // If we can't derive a USK from the given seed with the account's ZIP 32
+            // account index, then we immediately know the UIVK won't match because wallet
+            // accounts are required to have a known UIVK.
+            Err(_) => false,
+            Ok(usk) => {
+                usk.to_unified_full_viewing_key()
+                    .default_address(UnifiedAddressRequest::AllAvailableKeys)?
+                    == uivk.default_address(UnifiedAddressRequest::AllAvailableKeys)?
+            }
+        };
+
+    if seed_fingerprint_match != uivk_match {
+        // If these mismatch, it suggests database corruption.
+        Err(Error::CorruptedData(format!(
+            "Seed fingerprint match: {seed_fingerprint_match}, uivk match: {uivk_match}"
+        )))
+    } else {
+        Ok(seed_fingerprint_match && uivk_match)
+    }
+}
