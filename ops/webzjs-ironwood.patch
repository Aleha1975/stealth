+    fn set_tx_trust(&mut self, _txid: TxId, _trusted: bool) -> Result<(), <Self as WalletRead>::Error> {
+        // Trust is not tracked: every transaction is treated as untrusted (stricter, never looser).
+        tracing::warn!("set_tx_trust is not tracked by the in-memory wallet");
+        Ok(())
