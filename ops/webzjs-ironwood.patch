+                proto::PoolType::ShieldedOrchard | proto::PoolType::ShieldedIronwood => {
+                    return Err(Error::OrchardNotEnabled)
+                }
+                proto::PoolType::Transparent => SentNoteId::Transparent {
+                    txid: read_optional!(note_id, tx_id)?.try_into()?,
