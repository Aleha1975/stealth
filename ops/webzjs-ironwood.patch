diff --git a/crates/webzjs-wallet/src/compat.rs b/crates/webzjs-wallet/src/compat.rs
new file mode 100644
index 0000000..c09a86c
--- /dev/null
+++ b/crates/webzjs-wallet/src/compat.rs
@@ -0,0 +1,42 @@
+//! Glue between WebZjs and librustzcash 0.25 (Ironwood / NU6.3).
+
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use zcash_client_backend::util::Clock;
+use zcash_protocol::consensus::{BlockHeight, NetworkUpgrade, Parameters};
+use zcash_protocol::ShieldedPool;
+
+/// A [`Clock`] that works in the browser: `SystemTime::now()` panics on
+/// `wasm32-unknown-unknown`, so read `Date.now()` instead.
+#[derive(Clone, Copy)]
+pub struct JsClock;
+
+impl Clock for JsClock {
+    fn now(&self) -> SystemTime {
+        #[cfg(target_arch = "wasm32")]
+        {
+            UNIX_EPOCH + Duration::from_millis(js_sys::Date::now() as u64)
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            let _ = Duration::ZERO;
+            SystemTime::now().duration_since(UNIX_EPOCH).map_or(UNIX_EPOCH, |d| UNIX_EPOCH + d)
+        }
+    }
+}
+
+/// CSPRNG handed to librustzcash (rand 0.10), backed by the OS / `crypto.getRandomValues`.
+pub fn rng() -> rand_core::UnwrapErr<rand::rngs::SysRng> {
+    rand_core::UnwrapErr(rand::rngs::SysRng)
+}
+
+/// The shielded pool that receives change when a transaction has no shielded inputs.
+/// From NU6.3 Orchard is exit-only, so new funds must land in Ironwood.
+pub fn fallback_change_pool<P: Parameters>(params: &P, chain_height: Option<BlockHeight>) -> ShieldedPool {
+    let target = chain_height.map_or(BlockHeight::from_u32(0), |h| h + 1);
+    if params.is_nu_active(NetworkUpgrade::Nu6_3, target) {
+        ShieldedPool::Ironwood
+    } else {
+        ShieldedPool::Orchard
+    }
+}
