+//! Advisory output locks (`OutputLockStore`) for the in-memory wallet.
+//!
+//! Semantics follow `zcash_client_sqlite::wallet::locking`: a lock is active while its expiry
+//! height is strictly greater than the chain tip; it blocks selection at target heights `<=` the
+//! expiry unless the caller's `LockedInputPolicy` names the lock owner.
+
+use std::collections::BTreeSet;
+
+use zcash_client_backend::{
+    data_api::{
+        WalletRead,
+        locking::{LockError, LockFilter, LockOwner, OutputLockStore},
+        wallet::TargetHeight,
+    },
+    wallet::OutputRef,
+};
+use zcash_protocol::{PoolType, consensus};
+
+use crate::{AccountId, MemoryWalletDb, error::Error};
+
+impl<P: consensus::Parameters> MemoryWalletDb<P> {
+    fn lock_tip(&self) -> Result<u32, Error> {
+        Ok(self.chain_height()?.map(u32::from).unwrap_or(0))
+    }
+
+    /// Does the output exist in the wallet? Returns the owning account if so.
+    fn output_account(&self, output: &OutputRef) -> Option<AccountId> {
+        match output.pool() {
+            PoolType::Shielded(pool) => self
+                .received_notes
+                .iter()
+                .find(|n| {
+                    n.txid == *output.txid()
+                        && n.output_index == output.output_index()
+                        && n.note.pool() == pool
+                })
+                .map(|n| n.account_id),
+            #[cfg(feature = "transparent-inputs")]
+            PoolType::Transparent => self
+                .transparent_received_outputs
+                .iter()
+                .find(|(op, _)| op.txid() == output.txid() && op.n() == output.output_index())
+                .map(|(_, o)| o.account_id),
+            #[cfg(not(feature = "transparent-inputs"))]
+            PoolType::Transparent => None,
+        }
+    }
+
+    /// Is the output excluded from selection at `target_height` under `lock_filter`?
+    pub(crate) fn output_excluded_by_lock(
+        &self,
+        output: &OutputRef,
+        target_height: TargetHeight,
+        lock_filter: LockFilter<'_>,
+    ) -> bool {
+        match (self.output_locks.get(output), lock_filter) {
+            (None, _) | (_, LockFilter::Unfiltered) => false,
+            (Some((owner, expiry)), LockFilter::Policy(policy)) => {
+                let locked = u32::from(*expiry) >= u32::from(target_height);
+                locked && !policy.overridable_owners().contains(owner)
+            }
+        }
+    }
+}
+
+impl<P: consensus::Parameters> OutputLockStore for MemoryWalletDb<P> {
+    type Error = Error;
+    type AccountId = AccountId;
+
+    fn lock_outputs(
+        &mut self,
+        outputs: &[OutputRef],
+        owner: LockOwner,
+        lock_expiry_height: zcash_protocol::consensus::BlockHeight,
+    ) -> Result<usize, LockError<Self::Error>> {
+        let tip = self.lock_tip().map_err(LockError::Storage)?;
+        // all-or-nothing: validate every output first
+        for o in outputs {
+            if self.output_account(o).is_none() {
+                return Err(LockError::LockFailure(*o));
+            }
+            if let Some((held_by, expiry)) = self.output_locks.get(o) {
+                if *held_by != owner && u32::from(*expiry) > tip {
+                    return Err(LockError::LockFailure(*o));
+                }
+            }
+        }
+        for o in outputs {
+            self.output_locks.insert(*o, (owner, lock_expiry_height));
+        }
+        Ok(outputs.len())
+    }
+
+    fn unlock_output(&mut self, output: &OutputRef, owner: LockOwner) -> Result<bool, Self::Error> {
+        match self.output_locks.get(output) {
+            Some((held_by, _)) if *held_by == owner => {
+                self.output_locks.remove(output);
+                Ok(true)
+            }
+            _ => Ok(false),
+        }
+    }
+
+    fn clear_locked_outputs(&mut self, account: Self::AccountId) -> Result<usize, Self::Error> {
+        let to_clear: BTreeSet<OutputRef> = self
+            .output_locks
+            .keys()
+            .filter(|o| self.output_account(o) == Some(account))
+            .copied()
+            .collect();
+        for o in &to_clear {
+            self.output_locks.remove(o);
+        }
+        Ok(to_clear.len())
+    }
+
+    fn get_locked_outputs(&self, account: Self::AccountId) -> Result<Vec<OutputRef>, Self::Error> {
+        let tip = self.lock_tip()?;
+        Ok(self
+            .output_locks
+            .iter()
+            .filter(|(_, (_, expiry))| u32::from(*expiry) > tip)
+            .filter(|(o, _)| self.output_account(o) == Some(account))
+            .map(|(o, _)| *o)
+            .collect())
+    }
+}
