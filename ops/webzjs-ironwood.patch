+    /// Queue-hygiene only (see the trait docs): the in-memory wallet never prunes its scan
+    /// queue, which is always bounded by the chain length, so this removes nothing.
+    fn prune_scan_queue_below(
+        &mut self,
+        _height: BlockHeight,
+        _retain_with_priority: Option<ScanPriority>,
+    ) -> Result<u64, <Self as WalletRead>::Error> {
+        Ok(0)
+    }
+
+    fn queue_rescan(
+        &mut self,
+        range: Range<BlockHeight>,
+    ) -> Result<(), <Self as WalletRead>::Error> {
+        if range.is_empty() {
+            return Ok(());
+        }
+        self.scan_queue.replace_queue_entries(
+            &range,
+            std::iter::once(ScanRange::from_parts(range.clone(), ScanPriority::Historic)),
+            true,
+        )
+    }
