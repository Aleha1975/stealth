# /opt/stealth/rh.env  -- copy, fill the <placeholders>, chmod 600, chown stealth:stealth. NEVER commit the filled file.
# Read by BOTH stealth-indexer-rh.service and stealth-relayer-rh.service (each ignores the variables it does not use).
# Layout: code in /opt/stealth (node_modules symlinked as for Base), all RH state in /opt/stealth/data-rh (the only writable path).

STEALTH_CHAIN=rh
# 1 = never fall back to /opt/stealth/relayer.env (Base key) or /opt/mprhedged/exec/.env if a variable is missing here
STEALTH_ENV_ONLY=1

# ---- RPC. Several URLs comma separated = failover in order. Use a private/paid endpoint for production; the public one is the fallback.
# (never an RPC that bills per call without a cap: the indexer polls every STEALTH_POLL s)
STEALTH_RPC=<primary RH rpc url>,https://rpc.mainnet.chain.robinhood.com
# audit 1124: the relayer's nonce reads, transaction probes and sends all use ONE sticky endpoint (the first entry) and move to the next only when the first is unreachable (logged); the others serve plain reads

# ---- contracts
STEALTHPAY=<StealthPay address on Robinhood Chain after deploy>

# ================= indexer (stealth_indexer.py) =================
STEALTH_PORT=3883
STEALTH_DB=/opt/stealth/data-rh/announcements.db
# static history pages for nginx (see stealth-rh.conf); the service user needs write access, nginx read access
STEALTH_PAGES_DIR=/opt/stealth/data-rh/pages
# RH block time ~0.25 s; head = latest - CONFIRMATIONS (reorg guard re-reads the window every RECONCILE_EVERY s)
STEALTH_HEAD_MODE=latest
STEALTH_CONFIRMATIONS=20
STEALTH_RECONCILE_EVERY=60
STEALTH_POLL=2
# first run: start at the StealthPay deploy block (set it!), else head-BACKFILL
STEALTH_START_BLOCK=<block of the StealthPay deployment>
STEALTH_BACKFILL=200000
STEALTH_CHUNK=50000
MIN_KNOWN_USDC=100000
STEALTH_BAL_TTL=15
STEALTH_MAX_THREADS=64
STEALTH_SOCK_TIMEOUT=10

# ================= relayer (relayer.mjs) =================
STEALTH_RELAY_PORT=3884
STEALTH_INDEXER=http://127.0.0.1:3883
STEALTH_RELAY_STATE=/opt/stealth/data-rh/relayer_state.rh.json
STEALTH_RELAY_LOG=/opt/stealth/data-rh/relayer.rh.log
# a NEW dedicated key for RH (not the Base relayer key). Fund it with ~0.05 ETH on RH.
RELAYER_KEY=<0x + 64 hex, generated on the server, never printed>

# Gas sizing, measured on an anvil fork of RH (load_test.mjs) and the live node:
#   gasUsed: withdraw (transferWithAuthorization) ~102.5k, pay (payWithAuthorization) ~177k
#   live eth_gasPrice ~0.0208 gwei (baseFee 0.0202 gwei); NodeInterface.gasEstimateL1Component = 0 (no L1 charge visible)
#   -> withdraw ~2.1e-6 ETH, pay ~3.7e-6 ETH; 500 relays/day (half/half) ~1.5e-3 ETH/day
#   Budget 0.01 ETH/day = ~7x margin (price spikes up to 7x still pass). The reservation per request uses maxFeePerGas*1.25 (about 2-3x the real
#   price), so ~100 in-flight requests momentarily hold ~1e-3 ETH of the budget; they are reconciled to actual gas by receipts.
STEALTH_RELAY_GAS_BUDGET_WEI=10000000000000000
# refuse + ALERT below this relayer balance (0.001 ETH = ~500 relays); the watchdog warns earlier (0.003)
STEALTH_RELAY_MIN_BALANCE_WEI=1000000000000000
# USDG has 6 decimals. Min payment $0.10, pay fee $0.05 (cost to us ~$0.01), withdraw fee off
STEALTH_RELAY_MIN_USDC=100000
STEALTH_RELAY_PAY_FEE_MIN=50000
STEALTH_RELAY_PAY_FEE=50000
# Percentage pay fee, OFF by default (0 = the fixed fee above only). When set, a payment must carry fee >= max(STEALTH_RELAY_PAY_FEE_MIN, ceil(amount * BPS / 10000)); /relay/stats exposes pay_fee, pay_fee_min
# and pay_fee_bps and the pay screen computes the fee from them. 10 = 0.10% with the $0.05 minimum above. Integer 0..100; anything else stops the relayer at start. Change it, restart, nothing else.
STEALTH_RELAY_PAY_FEE_BPS=0
STEALTH_RELAY_FEE_MIN=0
# no per-IP daily cap any more (audit 1116 M-2: limits are per signer; nginx limit_req is the network burst guard); per payer wallet payments/day
# STEALTH_RELAY_FAIL_PER_SIGNER=30   (failed signed requests per signer per hour; default = STEALTH_RELAY_FAIL_PER_IP)
# STEALTH_RELAY_FAIL_PER_NET_SIGNED=300   (audit 1120 L-2: failures of FRESH signed requests per network and hour, i.e. throwaway signers; default = 10 x FAIL_PER_SIGNER)
# STEALTH_RELAY_GAP_GRACE_MS=15000   (audit 1120 M-2: a send of ours at the node's pending nonce younger than this is a lagging node, not a nonce gap)
STEALTH_RELAY_PAY_PER_PAYER=20
# RH blocks are ~0.25 s: no receipt for 20 s means stuck -> one same-nonce replacement with +30% fee
STEALTH_RELAY_STUCK_S=20
STEALTH_RELAY_BUMP_PCT=30
