# /opt/stealth-base/base.env  -- Base, StealthPay v3. Created by the operator (README_ops.txt, "Base v3"), chmod 600, owner stealth. NEVER commit the filled file.
# Read by BOTH stealth-indexer-base.service and stealth-relayer-base.service (each ignores the variables it does not use).
# This file does NOT replace the live Base stack: stealth-indexer / stealth-relayer (3873/3874, StealthPay v2, /opt/stealth, /opt/mprhedged/exec/.env) keep running untouched.
# Layout: code in /opt/stealth-base (node_modules symlinked as for RH), all state in /opt/stealth-base/data (the only writable path).

STEALTH_CHAIN=base
# 1 = never fall back to /opt/stealth/relayer.env or /opt/mprhedged/exec/.env (the shared file would lend RPC URLs only, but this stack must not depend on it)
STEALTH_ENV_ONLY=1

# ---- RPC. Several URLs comma separated = failover in order (the relayer sends and probes through the FIRST one; see rh.env.example). Add a private endpoint in front of the public one if you have it.
# (never an RPC that bills per call without a cap: the indexer polls every STEALTH_POLL s)
STEALTH_RPC=https://base-rpc.publicnode.com

# ---- contracts
# StealthPay v3 on Base: block 53408013, tx 0x7452b453589a259d6cd07814651b922624577963276a8e4ec470254a6619daa3, TOKEN() = USDC, ANNOUNCER() = 0x55649E01B5Df198D18D95b5cc5051630cfD45564
STEALTHPAY=0xC07f54984AbDa1EF76DaB6F602270B76a04E916d
# Old StealthPay v2 (comma separated): payments made through it stay findable AND stay withdrawable through the relayer (/known accepts these callers). Do not remove while v2 balances exist.
STEALTHPAY_LEGACY=0xc1b372731c1ee68ee89f212a05cb8ac9a7929f76

# ================= indexer (stealth_indexer.py) =================
STEALTH_PORT=3893
STEALTH_DB=/opt/stealth-base/data/announcements.db
# static history pages for nginx (see stealth-base.conf); the service user needs write access, nginx read access
STEALTH_PAGES_DIR=/opt/stealth-base/data/pages
# Start of the history: the SAME block as the live Base indexer (31700000, before StealthPay v2), NOT the v3 deploy block: the indexer reads every Announcer event from here,
# so payments made through v2 are in the new database and in the client's list. Starting at v3 (53408013) would hide all of them.
STEALTH_START_BLOCK=31700000
# Base head = the node's "safe" tag (chains.json: mode safe), polled every 20 s
STEALTH_HEAD_MODE=safe
STEALTH_CHUNK=50000
MIN_KNOWN_USDC=100000
STEALTH_BAL_TTL=15
STEALTH_MAX_THREADS=64
STEALTH_SOCK_TIMEOUT=10

# ================= relayer (relayer.mjs) =================
STEALTH_RELAY_PORT=3894
STEALTH_INDEXER=http://127.0.0.1:3893
STEALTH_RELAY_STATE=/opt/stealth-base/data/relayer_state.base.json
STEALTH_RELAY_LOG=/opt/stealth-base/data/relayer.base.log
# RELAYER_KEY is NOT in this example. The operator's one-liner (README_ops.txt) appends the line from the root-only file /opt/stealth/relayer.env, so the key never passes through a terminal.
# That is the key of the live Base relayer: while both relayers run they share ONE account and its nonce (see "Risks" in README_ops.txt); it is already funded on Base.
# Limits and gas budget: relayer.mjs defaults (budget 0.0002 ETH/day, refuse below 0.0001 ETH, 3 withdrawals per address per day, 20 pays per payer per day). USDC has 6 decimals, like USDG.
# Pay fee: the same $0.05 as on RH (a product decision, USD based, not chain based); the relayer's cost on Base is far smaller. Min payment $0.10. Withdraw fee off.
STEALTH_RELAY_MIN_USDC=100000
STEALTH_RELAY_PAY_FEE_MIN=50000
STEALTH_RELAY_PAY_FEE=50000
STEALTH_RELAY_FEE_MIN=0
# audit 1160 (all optional): same-nonce replacements per stuck send (3); seconds before the periodic check takes over a pending nonce nobody watches (default 2 x STEALTH_RELAY_STUCK_S = 120);
# hard ceiling on maxFeePerGas (default budget / 4 / 250000 = 0.2 gwei with the 0.0002 ETH/day budget); start refuses STEALTH_RELAY_PAY_FEE_MIN=0 while STEALTHPAY is set
# STEALTH_RELAY_MAX_REPLACE=3
# STEALTH_RELAY_MAX_FEE_WEI=200000000
