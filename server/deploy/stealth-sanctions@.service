[Unit]
Description=Refresh OFAC SDN EVM address list for the Stealth relayer %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stealth
Group=stealth
WorkingDirectory=/opt/stealth-%i/sanctions
ExecStart=/usr/bin/python3 -I /opt/stealth-%i/sanctions/update.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/stealth-%i/sanctions
