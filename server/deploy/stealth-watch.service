[Unit]
Description=Stealth watchdog (indexer lag, relayer balance, alerts)

[Service]
Type=oneshot
User=stealth
Group=stealth
WorkingDirectory=/opt/stealth-watch
EnvironmentFile=-/opt/stealth-watch/watch.env
ExecStart=/usr/bin/python3 /opt/stealth-watch/stealth_watch.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/stealth-rh /opt/stealth-base
ReadWritePaths=/opt/stealth-watch/data
MemoryMax=128M
