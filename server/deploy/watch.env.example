# /opt/stealth-watch/watch.env (chmod 600) -- no secrets in git
TG_BOT_TOKEN=<telegram bot token>
TG_CHAT_ID=<chat id>
STEALTH_WATCH_STATE=/opt/stealth-watch/data/watch_state.json
# chains to check: name=indexer_url|relayer_url|relayer_log|min_balance_eth ; ';' separated
STEALTH_WATCH_CHAINS=rh=http://127.0.0.1:3883|http://127.0.0.1:3884|/opt/stealth-rh/data/relayer.rh.log|0.0003;base=http://127.0.0.1:3893|http://127.0.0.1:3894|/opt/stealth-base/data/relayer.base.log|0.0003
# thresholds
STEALTH_WATCH_MAX_LAG_BLOCKS_base=30
# one repeat of the same alert per day at most (owner rule: Telegram only for real problems)
STEALTH_WATCH_REPEAT_S=86400
# rh: 2000 blocks = about 3.5 min at 104 ms per block (systemd env files take no trailing comments)
STEALTH_WATCH_MAX_LAG_BLOCKS_rh=2000
STEALTH_WATCH_MAX_AGE_S=120
