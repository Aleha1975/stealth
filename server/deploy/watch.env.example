# /opt/stealth/watch.env (chmod 600) -- no secrets in git
TG_BOT_TOKEN=<telegram bot token>
TG_CHAT_ID=<chat id>
STEALTH_WATCH_STATE=/opt/stealth/data-watch/watch_state.json
# chains to check: name=indexer_url|relayer_url|relayer_log|min_balance_eth ; ';' separated
STEALTH_WATCH_CHAINS=base=http://127.0.0.1:3873|http://127.0.0.1:3874|/opt/stealth/relayer.base.log|0.0003;rh=http://127.0.0.1:3883|http://127.0.0.1:3884|/opt/stealth/data-rh/relayer.rh.log|0.0003
# thresholds
STEALTH_WATCH_MAX_LAG_BLOCKS_base=30
STEALTH_WATCH_MAX_LAG_BLOCKS_rh=200
STEALTH_WATCH_MAX_AGE_S=120
